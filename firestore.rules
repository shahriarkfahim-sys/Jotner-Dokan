rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isDev() {
      return isVerified() && request.auth.token.email == 'shahriar.fahim@brac.net';
    }

    function isAdmin() {
      return isDev() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.keys().size() == 7 && // uid, email, role, createdAt, displayName, photoURL, loyaltyPoints
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['customer', 'artisan', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'description', 'price', 'category', 'artisanId', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.artisanId is string &&
             (data.createdAt == request.time || data.createdAt is number || data.createdAt is timestamp);
    }

    function isValidArtisan(data) {
      return data.keys().hasAll(['name', 'bio', 'story']) &&
             data.name is string && data.name.size() <= 200 &&
             data.bio is string && data.bio.size() <= 1000 &&
             data.story is string && data.story.size() <= 10000;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'rating', 'createdAt']) &&
             data.productId is string &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'shippingAddress', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productId', 'addedAt']) &&
             data.userId == request.auth.uid &&
             data.productId is string &&
             data.addedAt == request.time;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'content', 'authorName', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'loyaltyPoints'])
      );
    }

    match /artisans/{artisanId} {
      allow read: if true;
      allow create: if (isOwner(artisanId) || isAdmin()) && isValidArtisan(incoming());
      allow update: if (isOwner(artisanId) || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'story', 'avatarUrl', 'location', 'specialties', 'disabilityInfo', 'socialLinks'])
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isVerified() && isValidProduct(incoming()) && (incoming().artisanId == request.auth.uid || isAdmin());
      allow update: if (isVerified() && (existing().artisanId == request.auth.uid || isAdmin())) && (
        incoming().diff(existing()).affectedKeys().hasAll(['name', 'description', 'price', 'category', 'tags', 'images', 'stock', 'rating', 'reviewCount', 'isFeatured'])
      );
      allow delete: if isAdmin() || (isVerified() && existing().artisanId == request.auth.uid);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isVerified() && isValidReview(incoming());
        allow update: if (isOwner(existing().userId) || isAdmin()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment'])
        );
        allow delete: if isOwner(existing().userId) || isAdmin();
      }
    }

    match /blog_posts/{postId} {
      allow read: if true;
      allow create: if isVerified() && isValidBlogPost(incoming());
      allow update: if (isVerified() && (existing().artisanId == request.auth.uid || isAdmin())) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'coverImage', 'tags'])
      );
      allow delete: if isAdmin() || (isVerified() && existing().artisanId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidOrder(incoming());
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingNumber'])
      );
    }

    match /wishlists/{wishlistId} {
      allow read: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidWishlist(incoming());
      allow delete: if isOwner(existing().userId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Cloud Console for safety
    }
  }
}
